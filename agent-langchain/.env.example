# MiniMax 开放平台生成的 API Key。
MINIMAX_API_KEY=your_minimax_api_key
# 使用的 MiniMax 文本模型。
MINIMAX_MODEL=MiniMax-M2.7
# 中国大陆的 OpenAI 兼容端点；国际版请改为 https://api.minimax.io/v1。
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# 百炼文本向量服务的 API 密钥。
DASHSCOPE_API_KEY=your_dashscope_api_key
# Elasticsearch 服务地址。
ES_URL=https://localhost:9200
# Elasticsearch 向量索引名称。
ES_INDEX_NAME=know-engine-vector
# Elasticsearch 基本认证用户名。
ES_USERNAME=your_es_username
# Elasticsearch 基本认证密码。
ES_PASSWORD=your_es_password
# Elasticsearch CA 证书文件路径。
ES_CA_CERTS=path/to/http_ca.crt
